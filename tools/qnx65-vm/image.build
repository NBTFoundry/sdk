# SPDX-License-Identifier: MPL-2.0
# QNX 6.5 ARMv7 boot image for the QEMU "virt" board: procnto, libc and the
# files under test. run.sh fills in @WORK@, the commands and the file list.
[linker="(40;1;)qcc -bootstrap -nostdlib -Wl,--no-keep-memory -Vgcc_ntoarmv7%(m!=3,%(m!=6,%(e==0, -EL%)%(e==1, -EB%)%)%)%(h!=0, -Wl,-Ttext -Wl,0x%t%)%(d!=0, -Wl,-Tdata -Wl,0x%d%) -o%o %i %[M -L%^i -Wl,-uinit_%n -lmod_%n%] @WORK@/libstartup.a -L${QNX_TARGET}/armle-v7/lib -L${QNX_TARGET}/armle-v7/usr/lib -llzo -lucl -ldrvr"]
[linker="(40;2;)cp %i %o"]
[image=0x40200000]
[virtual=armle-v7,raw] .bootstrap = {
    startup-virt -v -S
    PATH=:/proc/boot LD_LIBRARY_PATH=:/proc/boot procnto-smp -vvv
}
[+script] .script = {
    procmgr_symlink ../../proc/boot/libc.so.3 /usr/lib/ldqnx.so.2
    devc-serdebug -e -F -S
    waitfor /dev/ser1 4
    reopen /dev/ser1
    display_msg "@@NBT-START@@"
@COMMANDS@
    display_msg "@@NBT-END@@"
}
[type=link] /usr/lib/ldqnx.so.2=/proc/boot/libc.so.3
# data=copy: each run gets a fresh copy of a program's data segment, so a
# program can run more than once.
[perms=+r,+x data=copy]
libc.so.3
procnto-smp
devc-serdebug
# What nbt-runner links: the SP1 GF-based EGL/GLES2 (no GPU here: they fail
# at run time), the car's GNU C++ runtime, and a Screen stub (6.5 has none).
libsocket.so.3
libm.so.2
libEGL.so.1
libGLESv2.so.1
libstdc++.so.6=libstdc++.so.6.0.13
libscreen.so.1=@WORK@/libscreen.so.1
# Signals for lifecycle tests ("waitfor /none N" in the script is a sleep).
slay
